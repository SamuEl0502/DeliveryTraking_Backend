# Puerto del servidor (por defecto 3000)
PORT=3000
# development | test | production
NODE_ENV=development
# Origen(es) del frontend permitidos por CORS, separados por coma (obligatoria)
CORS_ORIGIN=http://localhost:5173
# Conexión a PostgreSQL instalado en local; cambia TU_CLAVE por la clave del usuario postgres
# Si la clave tiene caracteres especiales, codifícalos (@ -> %40, # -> %23)
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/delivery_tracking
# Con docker-compose.yml de la raíz (opcional), usa esta en su lugar:
# DATABASE_URL=postgresql://delivery:delivery@localhost:5432/delivery_tracking
# Credenciales OAuth2 de OpenSky; vacías = modo anónimo (cupo diario bajo)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Vida de la caché de OpenSky en ms (mínimo 10000)
OPENSKY_CACHE_TTL_MS=30000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Llave de Aviationstack (horarios, puertas y ruta real del tramo activo); vacía = deshabilitado
# Plan gratis: 100 peticiones al mes
AVIATIONSTACK_API_KEY=
# Llave de AirLabs (salidas programadas de GET /api/schedules); vacía = deshabilitado
# Cada consulta gasta créditos del plan gratis
AIRLABS_API_KEY=
# Tiempo en ms en que la misma ruta no vuelve a consultar AirLabs (por defecto 2400000 = 40 minutos)
SCHEDULE_CACHE_TTL_MS=2400000
# Tope de consultas reales a AirLabs por día (por defecto 30)
SCHEDULE_DAILY_LIMIT=30
# Plan B de demo: true sirve fixtures/opensky-sample.json en vez de llamar a OpenSky
# y fixtures/airlabs-sample.json en vez de llamar a AirLabs (no gasta créditos)
USE_FIXTURE=false
# Secretos de autenticación (obligatorios, mínimo 32 caracteres, uno distinto para cada uno)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_largo_de_acceso_123
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_largo_refresh_456
# Vida del access token en minutos y del refresh token en días
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
