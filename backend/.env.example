# Puerto del servidor (por defecto 3000)
PORT=3000
# development | test | production
NODE_ENV=development
# Origen(es) del frontend permitidos por CORS, separados por coma (obligatoria)
CORS_ORIGIN=http://localhost:5173
# Conexión a PostgreSQL instalado en local; cambia TU_CLAVE por la clave del usuario postgres
# Si la clave tiene caracteres especiales, codifícalos (@ -> %40, # -> %23)
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/delivery_tracking
# Con docker-compose.yml de la raíz (opcional), usa esta en su lugar:
# DATABASE_URL=postgresql://delivery:delivery@localhost:5432/delivery_tracking
# Credenciales OAuth2 de OpenSky; vacías = modo anónimo (cupo diario bajo)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Vida de la caché de OpenSky en ms (mínimo 10000)
OPENSKY_CACHE_TTL_MS=30000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Llave de Aviationstack (horarios, puertas y ruta real del tramo activo); vacía = deshabilitado
# Plan gratis: 100 peticiones al mes
AVIATIONSTACK_API_KEY=
# Plan B de demo: true sirve fixtures/opensky-sample.json en vez de llamar a OpenSky
USE_FIXTURE=false
