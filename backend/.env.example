# Puerto del servidor (por defecto 3000)
PORT=3000
# development | test | production
NODE_ENV=development
# Origen(es) del frontend permitidos por CORS, separados por coma (obligatoria)
CORS_ORIGIN=http://localhost:5173
# Conexión a PostgreSQL (se usará desde el Bloque 5, con Prisma)
DATABASE_URL=
# Credenciales OAuth2 de OpenSky; vacías = modo anónimo (cupo diario bajo)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Vida de la caché de OpenSky en ms (mínimo 10000)
OPENSKY_CACHE_TTL_MS=30000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Llave de AeroDataBox (horarios, puertas y estado del vuelo); vacía = deshabilitado
AERODATABOX_API_KEY=
# direct (api.aerodatabox.com) | rapidapi (aerodatabox.p.rapidapi.com, plan gratis Basic)
AERODATABOX_MARKET=direct
# Plan B de demo: true sirve fixtures/opensky-sample.json en vez de llamar a OpenSky
USE_FIXTURE=false
